# Base URL ของเว็บไซต์ (ใช้สร้าง metadata, robots, sitemap และลิงก์รูปภาพในแจ้งเตือน LINE)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# บัญชีผู้ดูแลระบบเริ่มต้นสำหรับคำสั่ง npm run db:seed (รันบน local Wrangler D1)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-please-123"
ADMIN_NAME="Owner"

# (ไม่บังคับ) LINE Messaging API สำหรับแจ้งเตือนคำสั่งซื้อ/สลิป — สามารถตั้งค่าผ่านหน้า /admin/settings ได้เช่นกัน
# หากใช้งานบน Production ควรตั้งผ่าน `wrangler secret put` หรือเมนูตั้งค่าในหลังบ้าน
# LINE_CHANNEL_ACCESS_TOKEN=""
# LINE_TARGET_ID=""

# หมายเหตุ: ระบบนี้ใช้ Cloudflare D1 (SQLite) และ Cloudflare R2 ตามค่า binding ใน wrangler.jsonc (DB, MEDIA)
# ไม่ต้องกำหนด DATABASE_URL หรือเปิด PostgreSQL บนเครื่อง
