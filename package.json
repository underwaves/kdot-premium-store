{
  "name": "kdot-premium-store",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node tests/hardening-in-memory.test.mjs",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:preflight": "wrangler d1 execute kdot-store-db --local --file=scripts/preflight-checks.sql",
    "db:preflight:remote": "wrangler d1 execute kdot-store-db --remote --file=scripts/preflight-checks.sql",
    "db:migrate": "wrangler d1 migrations apply kdot-store-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply kdot-store-db --remote",
    "db:seed": "tsx scripts/seed.ts",
    "db:seed-demo": "tsx scripts/seed-demo.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.16",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "jpeg-js": "^0.4.4",
    "jsqr": "^1.4.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "simple-icons": "^16.37.0",
    "upng-js": "^2.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/jpeg-js": "^0.3.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/upng-js": "^2.1.5",
    "dotenv": "^18.0.10",
    "drizzle-kit": "^0.31.11",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "wrangler": "^4.160.1"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "workerd@1.20261110.1": true
  }
}
